# Production web image: build the static site, then serve it with Caddy.
# Caddy also terminates TLS and proxies /api to the api service (deploy/Caddyfile),
# so the browser only ever talks to one origin.

FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci
COPY . .
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /app/dist /srv
