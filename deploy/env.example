# Copy to `.env` in the repo root on the server: `cp deploy/env.example .env`.
# docker compose reads it automatically.

# The domain Caddy asks a certificate for. www.<domain> redirects to it.
# Only used by docker-compose.prod.yml (the standalone stack).
RIVUON_DOMAIN=ribuon.com

# Only for docker-compose.behind-proxy.yml: the Docker network of the proxy
# that already owns 80/443, so it can reach rivuon-web by name. Find it with
#   docker inspect <proxy-container> \
#     --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{end}}'
# RIVUON_PROXY_NETWORK=mbti-app_mbtinfo-network
