# Copy to `.env` in the repo root on the server: `cp deploy/env.example .env`.
# docker compose reads it automatically.

# The domain Caddy asks a certificate for. www.<domain> redirects to it.
# Only used by docker-compose.prod.yml (the standalone stack).
RIBUON_DOMAIN=ribuon.com

# Only for docker-compose.behind-proxy.yml: the Docker network of the proxy
# that already owns 80/443, so it can reach ribuon-web by name. Find it with
#   docker inspect <proxy-container> \
#     --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{end}}'
# RIBUON_PROXY_NETWORK=mbti-app_mbtinfo-network

# --- Optional login (docs/DEPLOY.md, "Login") --------------------------------
# Each way to log in turns on when its settings are here; leave them all out and
# there is no login button. This file then holds secrets: `chmod 600 .env`.

# Sign in with Google: OAuth client (Web application) from console.cloud.google.com,
# authorized redirect URI https://<domain>/api/auth/google/callback
# RIBUON_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# RIBUON_GOOGLE_CLIENT_SECRET=GOCSPX-...

# Login links by email, through any SMTP relay (Resend, Brevo, Amazon SES...).
# Port 587 or 2587 uses STARTTLS, 465 or 2465 TLS from the start. DigitalOcean
# blocks 25, 465 and 587 going out, so use 2587 there. The From address's domain
# needs the relay's SPF/DKIM records, or the mail lands in spam.
# RIBUON_SMTP_HOST=smtp.resend.com
# RIBUON_SMTP_PORT=2587
# RIBUON_SMTP_USER=resend
# RIBUON_SMTP_PASSWORD=re_...
# RIBUON_MAIL_FROM="ריבועון <login@ribuon.com>"
# Replies to a login email go here (default: the maintainer's address).
# RIBUON_MAIL_REPLY_TO=you@example.com
